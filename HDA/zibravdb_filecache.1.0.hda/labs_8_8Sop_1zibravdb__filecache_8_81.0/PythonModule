import os

def openDirectory(kwargs):
    path = kwargs['node'].parm('file').evalAsString()
    if not path:
        hou.ui.displayMessage('No file path set.', severity=hou.severityType.Warning)
        return
    directory = os.path.dirname(path)
    if not os.path.isdir(directory):
        hou.ui.displayMessage('Directory does not exist:\n' + directory,
                              severity=hou.severityType.Warning)
        return
    hou.ui.showInFileBrowser(os.path.join(directory, ''))

def render(kwargs):

    hda = kwargs['node']
    error_sop = hda.node('input_error')
    # Required, otherwise errors may fail to update on pressing render.
    try:
        error_sop.cook()
    except:
        pass

    if len(error_sop.errors()) == 0:
        rop = hda.node('rop_zibravdb_compress')
        rop.parm('execute').pressButton()
        if len(rop.errors()) == 0:
            hda.parm('loadfromdisk').set(1)
            hda.parm('reload').pressButton()
        else:
            hda.parm('loadfromdisk').set(0)

    else:
        hda.parm('loadfromdisk').set(0)
        print(error_sop.errors()[0])

    return

