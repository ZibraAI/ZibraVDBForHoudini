Checks: >
  -*,
  readability-identifier-naming,
  modernize-use-override,
  readability-make-member-function-const,
  google-global-names-in-headers,
  cppcoreguidelines-use-enum-class,
  performance-unnecessary-copy-initialization

HeaderFilterRegex: '.*[\\/](src|common|AssetResolver)[\\/].*'
WarningsAsErrors: '*'
FormatStyle: file

CheckOptions:
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  # Houdini operator classes use HDK prefix convention: e.g SOP_ZibraVDBDecompressor
  readability-identifier-naming.ClassIgnoredRegexp: '^[A-Z]{3}_[A-Z][A-Za-z0-9]*(_[A-Z][A-Za-z0-9]*)?$'
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase

  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase

  # small data structs may use float x, y, z, and we don't check public therefore
  readability-identifier-naming.PrivateMemberPrefix: 'm_'
  readability-identifier-naming.PrivateMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberPrefix: 'm_'
  readability-identifier-naming.ProtectedMemberCase: CamelCase

  # Static class attributes: ms_BufferSize
  readability-identifier-naming.ClassMemberPrefix: 'ms_'
  readability-identifier-naming.ClassMemberCase: CamelCase

  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE

  # Abbreviation at the start is allowed. e.g UAVs, RHIFactory
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.LocalVariableIgnoredRegexp: '^[A-Z]{3}[a-z0-9]*([A-Z][a-z0-9]*)*$'

  readability-identifier-naming.GlobalVariablePrefix: 'g_'
  readability-identifier-naming.GlobalVariableCase: CamelCase

  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
